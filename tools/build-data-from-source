#!/bin/bash
# Regenerate data/ from the PCX images in data_src/.
# Run from the top of the source tree after building pcx2pgd
# (make, or cmake --build build --target pcx2pgd).
set -e
PCX2PGD="${PCX2PGD:-build/pcx2pgd}"
cat data_src/pcx.lst | while read pgd pcx name end width height; do
    echo "pgd $pgd pcx $pcx name $name end $end width $width height $height"
    base=$(echo $pcx | sed 's/.pcx$//')
    "$PCX2PGD" $base dummy $width $height > /dev/null
    printf "$name" | dd bs=1 seek=8 count=7 of=$base.pgd conv=notrunc 2> /dev/null
    printf "$end" | dd bs=1 seek=$(expr $(wc -c < $base.pgd) - 1) count=1 of=$base.pgd conv=notrunc 2> /dev/null
    mkdir -p $(dirname $pgd)
    mv $base.pgd $pgd
done
