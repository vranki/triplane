#!/bin/bash
set -e
triplane="$1"
testdir="$2"
tmptestdir="$(mktemp -d "${TMPDIR:-/tmp}/triplane-testsuite.XXXXXXXXXX")"
(cd "$testdir"; cp -R . "$tmptestdir")

SDL_VIDEODRIVER=dummy SDL_AUDIO_DRIVER=dummy TRIPLANE_HOME="$tmptestdir" \
    "$triplane" $(cat "$tmptestdir/args") > "$tmptestdir/output" || true

if ! cmp -s "$testdir/output.reference" "$tmptestdir/output"; then
    echo "Test failed. Please investigate $tmptestdir"
    exit 1
fi

rm -r "$tmptestdir"
